# Copy to .env and fill in the values you need. Never commit the real .env file.
#
# Mock mode (default) needs none of these -- `pytest tests/` and every CLI
# command run entirely against mocked connectors without any env vars set.
#
# Real Jira/Confluence integration (connector_mode_overrides={"jira": "real"}
# and/or {"confluence": "real"}) reads these at call time, in
# src/enterprise_agent/connectors/atlassian_mcp.py. See README.md's
# "Real Jira + Confluence" section for full setup instructions.

# Required. Your Atlassian site, e.g. https://yoursite.atlassian.net
ENTERPRISE_AGENT_ATLASSIAN_SITE_URL=

# Optional. Override the Atlassian remote MCP server URL (defaults to
# https://mcp.atlassian.com/v1/mcp).
ENTERPRISE_AGENT_ATLASSIAN_MCP_URL=

# Headless API token auth (recommended for CI/cron/ephemeral environments).
# Set EMAIL + API_TOKEN together (sent as HTTP Basic auth), OR set API_KEY
# alone (service-account key, sent as a Bearer token). Leave all three blank
# to fall back to a locally stored interactive OAuth session instead
# (`claude mcp add --transport http atlassian https://mcp.atlassian.com/v1/mcp`).
ENTERPRISE_AGENT_ATLASSIAN_EMAIL=
ENTERPRISE_AGENT_ATLASSIAN_API_TOKEN=
ENTERPRISE_AGENT_ATLASSIAN_API_KEY=

# Real GitHub integration (connector_mode_overrides={"github": "real"}) reads
# these at call time, in src/enterprise_agent/connectors/github_mcp.py.
# See README.md's "Real GitHub" section for full setup instructions.

# Required. "owner/repo" of the target repository.
ENTERPRISE_AGENT_GITHUB_REPO=

# Required. Fine-grained personal access token scoped to that repo's
# contents and pull-requests permissions only.
ENTERPRISE_AGENT_GITHUB_TOKEN=

# Optional. Base branch PRs are opened against (defaults to "main").
ENTERPRISE_AGENT_GITHUB_BASE_BRANCH=

# Optional. Override GitHub's hosted MCP server URL.
ENTERPRISE_AGENT_GITHUB_MCP_URL=
